# ============================================================
# 购物参谋 · 官方开放接口版（agentmart-api）环境变量
# 复制本文件为 .env 后填写真实值。不要把真实 .env 提交进 Git。
# 所有凭据都是可选的：不填也能完整启动，界面会诚实显示「未接入」。
# ============================================================

# ------- App -------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------- Database -------
# 默认本地 SQLite，零配置。Postgres 示例：
# DATABASE_URL=postgresql+asyncpg://agentmart:password@localhost:5432/agentmart
DATABASE_URL=sqlite+aiosqlite:///./agentmart.db

# ------- Cache -------
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=2000

# ------- Outbound HTTP (platform APIs) -------
# 出站请求只允许 http/https，并在请求前校验 host，
# 拒绝 localhost、环回、私有与保留地址（防 SSRF）。
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=2

# ------- JD 京东开放平台 (https://open.jd.com/) -------
# 需要申请：京东开放平台开发者资质 + 联盟推广权限（jd.union.open.*）
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
JD_API_BASE_URL=https://api.jd.com/routerjson

# ------- Taobao / Tmall 淘宝开放平台 (https://open.taobao.com/) -------
# 需要申请：淘宝开放平台应用 + 淘宝客（tbk）权限
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ACCESS_TOKEN=
TAOBAO_API_BASE_URL=https://eco.taobao.com/router/rest

# ------- Pinduoduo 拼多多开放平台 (https://open.pinduoduo.com/) -------
# 需要申请：拼多多开放平台应用资质（DDK 商品推广 API）
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_API_BASE_URL=https://gw-api.pinduoduo.com/api/router

# ------- Douyin 抖音开放平台 (https://open.douyin.com/) -------
# 需要申请：抖音开放平台应用 + 电商/团购带货权限
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=
DOUYIN_API_BASE_URL=https://open.douyin.com
# 商品搜索接口路径：在开放平台控制台「已授权接口」列表中查找后填写
# （例如 /goodlife/v1/goods/search），不同应用资质可用接口不同
DOUYIN_GOODS_SEARCH_PATH=

# ------- Bilibili -------
# 可选：BILIBILI_SESSDATA 仅用于启用「视频搜索」能力（个人 Cookie，勿提交）。
# 不配置时仍可通过公开接口解析用户提交的视频链接元数据。
BILIBILI_SESSDATA=

# ------- LLM (optional, off by default) -------
# 仅用于可选的「AI 观点归纳」，界面上会明确标注「AI 分析」。
# 不配置时推荐与归纳全部由本地规则完成。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ------- Admin token for curation APIs (optional) -------
# 评测整理接口的写入令牌。留空时本地开发默认允许（仅限 development 环境）。
CURATION_ADMIN_TOKEN=
