# ============================================================
# 购物参谋 · 个人浏览器版（agentmart-browser）环境变量
# 复制本文件为 .env 后按需填写。不要把真实 .env 提交进 Git。
# 本版本不接入任何电商开放接口，因此没有任何平台 AppKey 配置。
# ============================================================

# ------- App -------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ------- Database -------
# 只存任务记录（含中断可恢复的中间结果），不存任何账号、Cookie、密码。
DATABASE_URL=sqlite+aiosqlite:///./agentmart.db

# ------- 个人浏览器版 -------
# 浏览器登录态（profile 目录）与 model.json 的根目录。
# 默认放在用户主目录 ~/.agentmart，在仓库之外，
# 从结构上保证登录态不会被提交进 Git。填绝对路径可改位置。
AGENTMART_HOME=

# 模型调用上限：超出后该任务停止调用并说明原因，不会继续花钱。
AGENTMART_MODEL_MAX_CALLS=40
AGENTMART_MODEL_MAX_COST=5.0

# ------- 自带模型（BYO Key，可选）-------
# 通常直接在界面「平台与模型」里填，填完先做连接与视觉能力测试；
# 用环境变量适合 CI，或不想把 Key 写进本地配置文件的情况。
# 注意：Key 只存在本机 AGENTMART_HOME 下，不会随请求发给任何第三方服务。
# 不配置时：应用照常启动、界面照常浏览、任务框架照常可跑，只是不调用任何外部模型。
AGENTMART_MODEL_API_KEY=
AGENTMART_MODEL_BASE_URL=
AGENTMART_MODEL_NAME=
